{
  uid: "JOB_0001",
  metadata: {
    job_name: "Corporate Actions Report",
    description: "Fetch corporate actions daily",
    enabled: true,
    created_by: "Kaustubh",
  },
  api_data: {
    base_url: "https://api.example.com",
    endpoint: "/corporate-actions",
    method: "GET",
    verify_ssl: true,
    timeout: 20,
    headers: {
      Authorization: "Bearer <TOKEN>",
    },
    auth: {
      type: "none",
    },
    params: [
      {
        name: "from_date",
        type: "date",
        required: true,
        location: "query",
        value: "2026-06-01",
      },
      {
        name: "to_date",
        type: "date",
        required: true,
        location: "query",
        value: "2026-06-30",
      },
      {
        name: "series",
        type: "list",
        required: false,
        location: "query",
        values: ["EQ", "IV"],
      },
    ],
  },
  response: {
    source_type: "json",
    record_path: null,
    flatten: true,
    pagination: {
      enabled: false,
    },
  },
  output: {
    format: "excel",
    mode: "single_sheet",
    filename: "corporate_actions",
    timestamp_suffix: true,
  },
  storage: {
    save_raw_response: true,
    save_logs: true,
    retention_days: 30,
  },
  scheduler: {
    enabled: true,
    timezone: "Asia/Kolkata",
    days: ["MON", "TUE", "WED", "THU", "FRI"],
    times: ["09:00", "15:00"],
  },
  mailer: {
    enabled: true,
    notify_on_success: true,
    notify_on_failure: true,
    recipients: {
      to: ["ops@company.com"],
      cc: ["manager@company.com"],
    },
  },
}

